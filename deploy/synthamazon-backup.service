[Unit]
Description=SynthAmazon consistent database backup

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /docker/synthamazon/deploy/backup.py
UMask=0077
Nice=19
IOSchedulingClass=idle
CPUAccounting=true
CPUWeight=1
CPUQuota=20%
IOAccounting=true
IOWeight=10
MemoryMax=1G
TimeoutStartSec=30min
TimeoutStopSec=20s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/docker/synthamazon/data /docker/synthamazon/backups
