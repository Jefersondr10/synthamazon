# Generate the final file on the VPS. Never commit or publish its secrets.
http_address = "0.0.0.0:4180"
provider = "oidc"
provider_display_name = "Google"
oidc_issuer_url = "https://accounts.google.com"
scope = "openid email"
client_id = "REPLACE_WITH_SYNTHAMAZON_GOOGLE_CLIENT_ID"
client_secret_file = "/run/secrets/google-client-secret"
redirect_url = "https://synthamazon.nucleodeoperacao.com.br/oauth2/callback"
authenticated_emails_file = "/etc/synthamazon/allowed-emails.txt"
upstreams = ["http://synthamazon-backend:3000/"]
reverse_proxy = true
pass_host_header = true
pass_basic_auth = true
pass_user_headers = true
prefer_email_to_user = true
basic_auth_password = "REPLACE_WITH_PRIVATE_PROXY_PASSWORD"
skip_auth_strip_headers = true
pass_access_token = false
pass_authorization_header = false
skip_jwt_bearer_tokens = false
insecure_oidc_skip_nonce = false
code_challenge_method = "S256"
cookie_name = "__Host-synthamazon"
cookie_secret_file = "/run/secrets/cookie-secret"
cookie_secure = true
cookie_httponly = true
cookie_samesite = "lax"
cookie_expire = "12h"
cookie_refresh = "1h"
cookie_csrf_per_request = true
cookie_csrf_per_request_limit = 3
api_routes = ["^/api/"]
request_logging = false
auth_logging = false
standard_logging = true
show_debug_on_error = false
banner = "SynthAmazon — acesso restrito"
footer = "-"
